static inline bool bitmapGetPixel_P(const unsigned char* bitmap, int w, int h, int x, int y) {
  if (x < 0 || y < 0 || x >= w || y >= h) return false;
  const int byteWidth = (w + 7) / 8;
  const int byteIndex = y * byteWidth + (x >> 3);
  const uint8_t b = pgm_read_byte(bitmap + byteIndex);
  return (b & (0x80 >> (x & 7))) != 0;
}

static void drawBitmapFitToOled_P(const unsigned char* bitmap, int srcW, int srcH) {
  if (srcW <= 0 || srcH <= 0) return;

  const float sx = (float)SCREEN_WIDTH / (float)srcW;
  const float sy = (float)SCREEN_HEIGHT / (float)srcH;
  const float scale = (sx < sy) ? sx : sy;

  int drawW = (int)(srcW * scale + 0.5f);
  int drawH = (int)(srcH * scale + 0.5f);
  if (drawW < 1) drawW = 1;
  if (drawH < 1) drawH = 1;

  const int offX = (SCREEN_WIDTH - drawW) / 2;
  const int offY = (SCREEN_HEIGHT - drawH) / 2;

  const uint32_t xStep = ((uint32_t)srcW << 16) / (uint32_t)drawW;
  const uint32_t yStep = ((uint32_t)srcH << 16) / (uint32_t)drawH;

  uint32_t srcYfp = 0;
  for (int y = 0; y < drawH; y++) {
    const int srcY = (int)(srcYfp >> 16);
    uint32_t srcXfp = 0;
    for (int x = 0; x < drawW; x++) {
      const int srcX = (int)(srcXfp >> 16);
      if (bitmapGetPixel_P(bitmap, srcW, srcH, srcX, srcY)) {
        display.drawPixel(offX + x, offY + y, SSD1306_WHITE);
      }
      srcXfp += xStep;
    }
    srcYfp += yStep;
  }
}

